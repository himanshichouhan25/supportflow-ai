# .env.example — copy to .env and fill in real values before running.
# Never commit your actual .env to source control.

# PostgreSQL connection string (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/ai_customer_support

# Gemini API key (https://aistudio.google.com/app/apikey)
# Leave blank or omit to run in stub/offline mode (agents still work deterministically).
GEMINI_API_KEY=your_gemini_api_key_here
